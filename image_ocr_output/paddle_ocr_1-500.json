        ]
      },
      {
        "text": "“藝術是有分鬥，在此提醒，是各有專精，各有職掌”",
        "bounding_box": [
          7,
          70,
          225,
          81
        ]
      },
      {
        "text": "美術是有分門，有描繪的、欣賞的、鑑定真假的、批評的、搞",
        "bounding_box": [
          7,
          82,
          264,
          92
        ]
      },
      {
        "text": "美史的、寫理論的、装錶修復的、收藏的、、，當然，在就因",
        "bounding_box": [
          7,
          94,
          258,
          104
        ]
      },
      {
        "text": "學養之不同，於之各門，各有精通，在南朝謝赫於《古畫",
        "bounding_box": [
          7,
          105,
          261,
          115
        ]
      },
      {
        "text": "品錄》提到：「古及今，各善一節。」謝赫意思為自古到今，",
        "bounding_box": [
          7,
          117,
          253,
          126
        ]
      },
      {
        "text": "描畫之學門是多，往往在因之修學路途的關係，就只各精通其",
        "bounding_box": [
          7,
          128,
          264,
          138
        ]
      },
      {
        "text": "中一個方面。在美術之领域，是各門有各之才，各有各的强、",
        "bounding_box": [
          7,
          140,
          260,
          150
        ]
      },
      {
        "text": "各有各的好，是各有職掌。",
        "bounding_box": [
          7,
          151,
          117,
          161
        ]
      },
      {
        "text": "那告知~我喜愛讀美術資料，我有讀書畫譜，當然，我不是什",
        "bounding_box": [
          6,
          162,
          263,
          173
        ]
      },
      {
        "text": "麼美術書都有讀懂，當然，我不是每一篇書畫譜都有讀會，當",
        "bounding_box": [
          7,
          174,
          264,
          184
        ]
      },
      {
        "text": "然，有人喚我們是美史或理論。",
