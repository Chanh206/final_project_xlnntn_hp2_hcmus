# API phải tương thích endpoint /chat/completions và nhận image_url base64.
OCR_API_KEY=replace_with_your_key
OCR_BASE_URL=https://your-provider.example/v1
OCR_MODEL=replace_with_vision_model
# Ba biến OCR_* cũng được bước 8 dùng với --provider compatible.
# Có thể dùng OCR_API_URL thay OCR_BASE_URL nếu muốn chỉ rõ /chat/completions.

# Bước 5: DeepSeek phân xử caption/Gemini/PP-OCRv6 theo ảnh.
# Nếu dùng cùng provider/key OCR, chỉ cần đặt DEEPSEEK_MODEL; script tự dùng
# OCR_API_KEY và OCR_BASE_URL làm fallback. Model phải hỗ trợ image_url.
DEEPSEEK_MODEL=replace_with_deepseek_vision_model
# DEEPSEEK_API_KEY=replace_with_key_if_different_from_ocr
# DEEPSEEK_BASE_URL=https://provider.example/v1

# Qwen adjudication (model phải hỗ trợ ảnh). Nếu cùng provider/key OCR thì chỉ
# cần QWEN_MODEL; script fallback về OCR_API_KEY và OCR_BASE_URL.
QWEN_MODEL=replace_with_qwen_vision_model
# QWEN_API_KEY=replace_with_key_if_different_from_ocr
# QWEN_BASE_URL=https://provider.example/v1

# Bước 8: hiệu chỉnh/tách câu bằng OpenAI Responses API.
# Sao chép file này thành .env và không commit API key.
OPENAI_API_KEY=replace_with_your_openai_key
LLM_CORRECTION_MODEL=gpt-5.5

# Bước 8 local (không cần key):
OLLAMA_API_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen3-vl:8b
