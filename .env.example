# API phải tương thích endpoint /chat/completions và nhận image_url base64.
OCR_API_KEY=replace_with_your_key
OCR_BASE_URL=https://your-provider.example/v1
OCR_MODEL=replace_with_vision_model
# Ba biến OCR_* cũng được bước 8 dùng với --provider compatible.
# Có thể dùng OCR_API_URL thay OCR_BASE_URL nếu muốn chỉ rõ /chat/completions.

# Bước 8: hiệu chỉnh/tách câu bằng OpenAI Responses API.
# Sao chép file này thành .env và không commit API key.
OPENAI_API_KEY=replace_with_your_openai_key
LLM_CORRECTION_MODEL=gpt-5.5

# Bước 8 local (không cần key):
OLLAMA_API_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen3-vl:8b
